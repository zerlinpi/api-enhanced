# Copy as an UNTRACKED .env.production, chmod 600; never commit secrets.
SITE_DOMAIN=music.example.com
PUBLIC_BASE_URL=https://music.example.com
POSTGRES_PASSWORD=replace-with-strong-random-db-secret
# Percent-encode special characters from POSTGRES_PASSWORD in the URL password component.
DATABASE_URL=postgres://community:replace-with-strong-random-db-secret@db:5432/artist_community
# Compose config provisions a private Redis at redis:6379 for all Node instances.
ARTIST_COMMUNITY_ADMIN_TOKEN=replace-with-32-or-more-random-characters
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=mailbox@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=music@example.com
ADMIN_BASIC_USER=moderator
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-unique-admin-password'
ADMIN_BASIC_HASH=replace-with-caddy-hashed-password

# Choose external if another reverse proxy already listens on TCP 80/443.
PROXY_MODE=bundled
