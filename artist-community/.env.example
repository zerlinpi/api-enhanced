# Copy variables to your shell or use your process manager (no .env auto-loader).
DATABASE_URL=postgres://community:change-me@127.0.0.1:5432/artist_community
ARTIST_COMMUNITY_PORT=3100
# Required for admin moderation endpoints. Set to a random >=32-character string.
ARTIST_COMMUNITY_ADMIN_TOKEN=replace-with-a-random-at-least-32-character-secret
# For HTTPS production: NODE_ENV=production makes the session cookie Secure.
NODE_ENV=development
