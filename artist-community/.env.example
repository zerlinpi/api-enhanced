# Development only. Export to your shell; the app does not auto-read .env.
DATABASE_URL=postgres://community:change-me@127.0.0.1:5432/artist_community
# Optional in development. Production requires Redis via Compose.
# REDIS_URL=redis://127.0.0.1:6379
ARTIST_COMMUNITY_PORT=3100
ARTIST_COMMUNITY_HOST=127.0.0.1
# Enable only behind a reverse proxy which overwrites X-Forwarded-For.
ARTIST_COMMUNITY_TRUST_PROXY=false
ARTIST_COMMUNITY_ADMIN_TOKEN=replace-with-random-token-of-at-least-32-characters
# Optional read/moderation reviewer credential (must differ from owner token).
# ARTIST_COMMUNITY_REVIEWER_TOKEN=use-a-separate-secret-of-at-least-32-characters
NODE_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3100
# Console mode prints verification/recovery links locally. Never use with real user accounts.
MAIL_MODE=console
# To send real mail, use MAIL_MODE=smtp and the variables below.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=mailbox@example.com
# MAIL_PASSWORD=strong-smtp-app-password
# MAIL_FROM=music@example.com
